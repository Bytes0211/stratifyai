
# .env file for environment variables
# Author: S Cotton
# Creation Date: Jan 16, 2026
# Last Modified: Feb 9, 2026
#
# This file contains environment variables for configuring the application.

# OpenAI API Key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
BRAVE_API_KEY=
STRATIFYAI_API_KEY=

# CORS settings
# Comma-separated origins, e.g. http://localhost:5173,https://app.example.com
CORS_ALLOWED_ORIGINS=
# Set true to allow wildcard origins (not recommended for production)
CORS_ALLOW_ALL=false

